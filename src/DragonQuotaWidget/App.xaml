<Application x:Class="DragonQuotaWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DragonQuotaWidget">
    <Application.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F2211B3A" />
            <Setter Property="Foreground" Value="#FFF8F6FF" />
            <Setter Property="BorderBrush" Value="#665F53A6" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Application.Resources>
</Application>
