<Window x:Class="DragonQuotaWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="傻龙插件设置"
        Width="460" Height="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF7F5FF"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FF342D52" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE1DCF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,6,0">
            <TextBlock Text="挂件设置" FontSize="23" FontWeight="Bold" Foreground="#FF2C2549" />
            <TextBlock Text="调整显示、互动、声音与窗口行为" FontSize="12" Foreground="#FF7D759C" Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,12" Padding="0,0,6,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="显示与统计" FontSize="16" FontWeight="Bold" Foreground="#FF342D52" Margin="0,0,0,13" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="窗口大小" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" />
                            <TextBlock x:Name="ScaleValueText" Grid.Column="1" Text="90%" FontSize="14" FontWeight="Bold" Foreground="#FF7567C7" />
                        </Grid>
                        <Slider x:Name="ScaleSlider" Minimum="0.5" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,11,0,4" ValueChanged="ScaleSlider_ValueChanged" />
                        <TextBlock x:Name="DimensionText" Text="约 241 × 270 像素" FontSize="11" Foreground="#FF8C84A7" />
                        <Separator Margin="0,14,0,12" Background="#FFE7E2F2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Token 统计区间" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" />
                                <TextBlock Text="自然日或滚动 24 小时" FontSize="11" Foreground="#FF8C84A7" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="TokenTimeRangeComboBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="当日 Token" />
                                <ComboBoxItem Content="过去 24 小时" />
                            </ComboBox>
                        </Grid>
                        <Separator Margin="0,14,0,12" Background="#FFE7E2F2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="长期消耗区间" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" />
                                <TextBlock Text="滚动 7 天、30 天或全部记录" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="SummaryTimeRangeComboBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="过去 7 天" />
                                <ComboBoxItem Content="过去 30 天" />
                                <ComboBoxItem Content="总消耗" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="互动与声音" FontSize="16" FontWeight="Bold" Foreground="#FF342D52" Margin="0,0,0,7" />
                        <CheckBox x:Name="SoundEnabledCheckBox" Content="启用龙娘按下与松开音效" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="155" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音效组合" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" VerticalAlignment="Center" />
                            <ComboBox x:Name="SoundSetComboBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="小黄鸭" />
                                <ComboBoxItem Content="音效 1" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音量" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" />
                            <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="55%" FontSize="13" FontWeight="Bold" Foreground="#FF7567C7" />
                        </Grid>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,9,0,0" ValueChanged="VolumeSlider_ValueChanged" />
                        <Separator Margin="0,15,0,13" Background="#FFE7E2F2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="“今日reset”互动锁定" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" />
                                <TextBlock Text="艺术字气泡固定期间禁止再次互动" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ResetLockValueText" Grid.Column="1" Text="3 秒" FontSize="13" FontWeight="Bold" Foreground="#FF7567C7" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="ResetLockSlider" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0" ValueChanged="ResetLockSlider_ValueChanged" />
                        <Separator Margin="0,15,0,13" Background="#FFE7E2F2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="信息框临时显示时间" FontSize="14" FontWeight="SemiBold" Foreground="#FF342D52" />
                                <TextBlock Text="额度模式点击、手动显示或任务完成后自动淡出" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="InfoPanelDurationValueText" Grid.Column="1" Text="5 秒" FontSize="13" FontWeight="Bold" Foreground="#FF7567C7" VerticalAlignment="Center" />
                        </Grid>
                        <Slider x:Name="InfoPanelDurationSlider" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0" ValueChanged="InfoPanelDurationSlider_ValueChanged" />
                        <CheckBox x:Name="ShowCodexActivityBubbleCheckBox" Content="工作时显示 Codex 可观察状态气泡" Margin="0,15,0,2" />
                        <TextBlock Text="显示思考中、调用工具、修改文件和可见工作摘要；不展示隐藏推理内容。" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="24,0,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionBorder}" Margin="0,0,0,2">
                    <StackPanel>
                        <TextBlock Text="窗口行为" FontSize="16" FontWeight="Bold" Foreground="#FF342D52" Margin="0,0,0,7" />
                        <CheckBox x:Name="LockPositionCheckBox" Content="固定位置（禁止拖动挂件）" />
                        <CheckBox x:Name="AlwaysOnTopCheckBox" Content="始终置顶" />
                        <CheckBox x:Name="AttachToCodexCheckBox" Content="贴靠 Codex 窗口右下角" />
                        <TextBlock Text="关闭贴靠后可自由放置；拖动只会在屏幕边缘限制，防止挂件显示不全。" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="24,-3,0,3" />
                        <CheckBox x:Name="StartWithCodexCheckBox" Content="随 Codex 启动并监测其运行状态" />
                        <TextBlock Text="Codex 出现时显示挂件，真正退出后自动隐藏。" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="24,-3,0,3" />
                        <CheckBox x:Name="MinimizeOnCloseCheckBox" Content="点击关闭时转入后台最小化（系统托盘）" />
                        <TextBlock Text="后台最小化后，可双击系统托盘图标恢复；托盘菜单可彻底退出。" TextWrapping="Wrap" FontSize="11" Foreground="#FF8C84A7" Margin="24,0,0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,6,0">
            <Button Style="{StaticResource ActionButton}" Content="取消" Background="#FFE8E4F3" Foreground="#FF4D4568" Click="CancelButton_Click" />
            <Button Style="{StaticResource ActionButton}" Content="应用" Background="#FF7567C7" Foreground="White" FontWeight="SemiBold" Click="ApplyButton_Click" />
        </StackPanel>
    </Grid>
</Window>
